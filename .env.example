# Salin berkas ini menjadi .env.local lalu isi nilainya.
#
#   cp .env.example .env.local
#
# JANGAN PERNAH mengisi .env.local dengan nilai dari percakapan, tangkapan
# layar, atau berkas yang sudah dipublikasikan. Berkas ini masuk daftar
# .gitignore dan tidak akan ikut ter-commit, tapi begitu nilainya pernah
# terlihat orang lain, anggap sudah bocor dan buat yang baru dari dasbor
# Supabase / konsol Google Cloud.

# --- Supabase -------------------------------------------------------------
# Diambil dari: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Kunci service role. INI RAHASIA UTAMA PROYEK INI.
#
# Perbedaannya dengan kunci anon:
#   - Kunci anon ikut dikirim ke setiap peramban pengunjung, sehingga
#     nilainya memang publik dan TIDAK boleh diberi hak apa pun.
#   - Kunci service role hanya hidup di proses server. Klien tidak pernah
#     menerimanya, dan tidak ada jalan dari peramban untuk membacanya.
#
# Dipakai oleh /api/admin untuk memeriksa peran pengelola dan menelusuri
# tabel. Tanpa kunci ini panel pengelolaan jatuh ke mode PIN lokal dan
# kehilangan akses basis data.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini AI ------------------------------------------------------------
# Diambil dari: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Alamat situs ---------------------------------------------------------
# Dibutuhkan untuk tautan absolut pada OpenGraph dan sitemap.
# Isi SETELAH situs di-host, misalnya:
#   NEXT_PUBLIC_SITE_URL=https://zippyverse.vercel.app
# Bila dibiarkan kosong, tautan akan memakai http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
